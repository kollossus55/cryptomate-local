# Secrets for the local app. Copy this file to .env and fill in what you need.
# .env is gitignored — never commit it.

# Required before the app can store exchange API keys. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#
# Losing this key makes any stored credentials permanently unreadable. That is
# deliberate — there is no recovery path.
EXCHANGE_ENCRYPTION_KEY=

# Optional: change the port the app runs on (default 8788).
# PORT=8788

# Operator identity shown in the UI and stamped on every record as created_by.
# Changing it after records exist is safe — the server migrates them on startup.
# OPERATOR_EMAIL=kollossus55@gmail.com
# OPERATOR_NAME=Administrator

# LLM provider, only needed if you set AI confirmation to "auto" or use the AI
# analysis pages. Base44 supplied this as a hosted service; locally it needs
# your own key.
#
# IMPORTANT: the AI confirmation gate FAILS CLOSED. If it is set to "auto" and
# no provider is configured here, every trade is rejected and the bot will scan
# all day without trading. The server warns about this at startup.
# LLM_PROVIDER=anthropic
# LLM_API_KEY=
# LLM_MODEL=claude-sonnet-4-5
