{
  "name": "AutoTradingSettings",
  "type": "object",
  "properties": {
    "is_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether auto-trading is enabled"
    },
    "execution_mode": {
      "type": "string",
      "enum": [
        "auto",
        "browser",
        "server"
      ],
      "default": "auto",
      "description": "Execution mode for auto-trading: 'auto' (prefers server), 'browser' (client-side only), 'server' (server-side only)"
    },
    "candle_interval": {
      "type": "string",
      "enum": [
        "15m",
        "30m",
        "1h",
        "4h",
        "1d"
      ],
      "default": "1h",
      "description": "Candle timeframe the signal engine uses to score and trade. Shorter intervals produce more signals (and more noise); longer intervals produce fewer, more reliable signals. The scheduler still runs every 10 minutes regardless."
    },
    "min_confidence": {
      "type": "number",
      "default": 70,
      "description": "Minimum AI confidence % to execute trade (0-100)"
    },
    "max_position_size_percent": {
      "type": "number",
      "default": 10,
      "description": "Maximum % of portfolio per trade"
    },
    "max_open_positions": {
      "type": "number",
      "default": 5,
      "description": "Maximum number of simultaneous open positions"
    },
    "max_daily_loss_percent": {
      "type": "number",
      "default": 5,
      "description": "Maximum daily loss % before stopping (circuit breaker)"
    },
    "allowed_risk_levels": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "low",
          "medium",
          "high"
        ]
      },
      "default": [
        "low",
        "medium"
      ],
      "description": "Which risk levels to allow for auto-trading"
    },
    "trade_types": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "buy",
          "sell"
        ]
      },
      "default": [
        "buy",
        "sell"
      ],
      "description": "Allowed trade types"
    },
    "max_trades_per_day": {
      "type": "number",
      "default": 10,
      "description": "Maximum trades per day"
    },
    "stop_loss_percent": {
      "type": "number",
      "default": 3,
      "description": "Initial stop loss percentage"
    },
    "take_profit_percent": {
      "type": "number",
      "default": 8,
      "description": "Initial take profit percentage"
    },
    "use_trailing_stop": {
      "type": "boolean",
      "default": false,
      "description": "Enable trailing stop loss"
    },
    "trailing_stop_percent": {
      "type": "number",
      "default": 2,
      "description": "Trailing stop distance in %"
    },
    "trailing_stop_activation": {
      "type": "number",
      "default": 3,
      "description": "Profit % needed to activate trailing stop"
    },
    "use_breakeven_protection": {
      "type": "boolean",
      "default": false,
      "description": "Enable break-even protection"
    },
    "breakeven_trigger_percent": {
      "type": "number",
      "default": 4,
      "description": "Profit % to trigger break-even protection"
    },
    "breakeven_offset_percent": {
      "type": "number",
      "default": 0.5,
      "description": "Offset above entry price for break-even stop"
    },
    "use_partial_profits": {
      "type": "boolean",
      "default": false,
      "description": "Enable partial profit taking"
    },
    "partial_profit_targets": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "profit_percent": {
            "type": "number"
          },
          "sell_percent": {
            "type": "number"
          }
        }
      },
      "default": [
        {
          "profit_percent": 5,
          "sell_percent": 50
        },
        {
          "profit_percent": 10,
          "sell_percent": 25
        }
      ],
      "description": "Partial profit targets"
    },
    "use_smart_routing": {
      "type": "boolean",
      "default": false,
      "description": "Enable smart order routing for optimal prices"
    },
    "max_slippage_percent": {
      "type": "number",
      "default": 0.5,
      "description": "Maximum acceptable slippage %"
    },
    "use_dynamic_slippage": {
      "type": "boolean",
      "default": false,
      "description": "Adjust slippage limits based on volatility"
    },
    "use_twap": {
      "type": "boolean",
      "default": false,
      "description": "Use TWAP for larger trades"
    },
    "twap_duration_minutes": {
      "type": "number",
      "default": 15,
      "description": "TWAP execution duration in minutes"
    },
    "twap_threshold_percent": {
      "type": "number",
      "default": 5,
      "description": "Position size % threshold to trigger TWAP"
    },
    "twap_num_orders": {
      "type": "number",
      "default": 5,
      "description": "Number of orders to split TWAP into"
    },
    "use_vwap": {
      "type": "boolean",
      "default": false,
      "description": "Use VWAP for volume-based execution"
    },
    "vwap_lookback_periods": {
      "type": "number",
      "default": 20,
      "description": "Number of periods for VWAP calculation"
    },
    "vwap_participation_rate": {
      "type": "number",
      "default": 10,
      "description": "Target % of market volume to participate"
    },
    "execution_strategy": {
      "type": "string",
      "enum": [
        "market",
        "limit",
        "smart_limit",
        "iceberg",
        "twap",
        "vwap"
      ],
      "default": "smart_limit",
      "description": "Order execution strategy"
    },
    "limit_offset_percent": {
      "type": "number",
      "default": 0.1,
      "description": "Limit order offset from current price %"
    },
    "order_timeout_seconds": {
      "type": "number",
      "default": 30,
      "description": "Timeout for limit orders before converting to market"
    },
    "use_dynamic_risk": {
      "type": "boolean",
      "default": false,
      "description": "Enable dynamic risk adjustment based on volatility"
    },
    "volatility_lookback_periods": {
      "type": "number",
      "default": 20,
      "description": "Periods to calculate volatility"
    },
    "high_volatility_threshold": {
      "type": "number",
      "default": 5,
      "description": "Volatility % threshold for high volatility"
    },
    "extreme_volatility_threshold": {
      "type": "number",
      "default": 10,
      "description": "Volatility % threshold for extreme conditions"
    },
    "volatility_position_reduction": {
      "type": "number",
      "default": 50,
      "description": "% to reduce position size in high volatility"
    },
    "use_circuit_breaker": {
      "type": "boolean",
      "default": true,
      "description": "Enable advanced circuit breaker"
    },
    "circuit_breaker_market_drop": {
      "type": "number",
      "default": 15,
      "description": "Market drop % to trigger circuit breaker"
    },
    "circuit_breaker_cooldown_minutes": {
      "type": "number",
      "default": 60,
      "description": "Cooldown period after circuit breaker triggers"
    },
    "circuit_breaker_triggered_at": {
      "type": "string",
      "description": "Timestamp when circuit breaker was triggered"
    },
    "use_portfolio_take_profit": {
      "type": "boolean",
      "default": false,
      "description": "Close all positions and halt for the day when the account's daily profit reaches the target %."
    },
    "portfolio_take_profit_percent": {
      "type": "number",
      "default": 5,
      "description": "Daily account profit % that triggers the portfolio take-profit (closes all, halts entries until next UTC day)."
    },
    "portfolio_take_profit_triggered_at": {
      "type": "string",
      "description": "UTC timestamp when the portfolio take-profit last fired. Cleared at UTC midnight so trading resumes."
    },
    "market_condition": {
      "type": "string",
      "enum": [
        "normal",
        "volatile",
        "extreme",
        "halted"
      ],
      "default": "normal",
      "description": "Current market condition assessment"
    },
    "trades_today": {
      "type": "number",
      "default": 0,
      "description": "Number of trades executed today"
    },
    "daily_loss": {
      "type": "number",
      "default": 0,
      "description": "Total loss today"
    },
    "last_trade_date": {
      "type": "string",
      "description": "Last trade execution date"
    },
    "assets_traded_today": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of asset symbols traded today (prevents duplicate trades)"
    },
    "dca_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Enable Dollar-Cost Averaging on dips"
    },
    "dca_multiplier": {
      "type": "number",
      "default": 1.5,
      "description": "Multiplier for next DCA buy amount"
    },
    "dca_dip_threshold": {
      "type": "number",
      "default": 5,
      "description": "Price drop % to trigger DCA buy"
    },
    "max_dca_buys": {
      "type": "number",
      "default": 3,
      "description": "Maximum number of DCA buys per position"
    },
    "trading_schedule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "days": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          },
          "default": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri"
          ]
        },
        "start_hour": {
          "type": "number",
          "default": 9
        },
        "end_hour": {
          "type": "number",
          "default": 17
        },
        "timezone": {
          "type": "string",
          "default": "UTC"
        }
      },
      "description": "Schedule for server-side auto-trading"
    },
    "kill_switch_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Master halt. Overrides every other setting, no deploy needed."
    },
    "daily_counters_date": {
      "type": "string",
      "description": "UTC date (YYYY-MM-DD) the daily counters belong to. Drives midnight rollover."
    },
    "daily_start_equity": {
      "type": "number",
      "description": "Equity at the start of the UTC day. Denominator for max_daily_loss_percent."
    },
    "run_lock_until": {
      "type": "string",
      "description": "Best-effort concurrency lease. Blocks overlapping worker runs on one portfolio."
    },
    "risk_per_trade_percent": {
      "type": "number",
      "default": 1,
      "description": "Percent of equity risked if the stop is hit. Drives ATR-based sizing."
    },
    "atr_stop_multiplier": {
      "type": "number",
      "default": 2,
      "description": "Stop distance in ATR multiples. Volatility-scaled, not a flat percent."
    },
    "max_gross_exposure_percent": {
      "type": "number",
      "default": 60,
      "description": "Cap on total invested capital. Position count alone does not bound market risk."
    },
    "max_correlation": {
      "type": "number",
      "default": 0.8,
      "description": "Reject a candidate whose returns correlate above this with an open position."
    },
    "indicator_settings": {
      "type": "object",
      "default": {},
      "description": "Which indicator families the signal engine uses."
    },
    "live_trading_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether live trading is enabled. When true, the auto-trading worker places real orders via liveOrderExecution."
    },
    "live_trading_requested_at": {
      "type": "string",
      "format": "date-time",
      "description": "UTC timestamp when live trading was requested. A 24h cooldown must pass before live trading can be enabled."
    },
    "exchange_connection_id": {
      "type": "string",
      "description": "ID of the ExchangeConnection to use for live order execution."
    },
    "ai_confirmation_mode": {
      "type": "string",
      "enum": [
        "off",
        "auto",
        "manual"
      ],
      "default": "off",
      "description": "AI confirmation gate before trade execution. 'off' = no gate, 'auto' = LLM reviews each signal server-side and blocks rejects, 'manual' = trades pause as pending approvals for the user to confirm in the UI."
    },
    "ai_confirmation_min_score": {
      "type": "number",
      "default": 70,
      "description": "In auto mode, the AI must return a confidence at or above this score for the trade to proceed."
    }
  },
  "required": [
    "is_enabled",
    "min_confidence",
    "max_position_size_percent"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}