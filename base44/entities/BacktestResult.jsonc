{
  "name": "BacktestResult",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the backtest run"
    },
    "strategy_config": {
      "type": "object",
      "properties": {
        "assets": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "min_confidence": {
          "type": "number"
        },
        "max_position_size": {
          "type": "number"
        },
        "stop_loss": {
          "type": "number"
        },
        "take_profit": {
          "type": "number"
        },
        "use_sentiment": {
          "type": "boolean"
        },
        "risk_level": {
          "type": "string"
        }
      },
      "description": "Strategy configuration used"
    },
    "period": {
      "type": "object",
      "properties": {
        "start_date": {
          "type": "string"
        },
        "end_date": {
          "type": "string"
        },
        "duration_days": {
          "type": "number"
        }
      },
      "description": "Historical period tested"
    },
    "initial_capital": {
      "type": "number",
      "default": 10000,
      "description": "Starting capital for backtest"
    },
    "final_capital": {
      "type": "number",
      "description": "Ending capital after backtest"
    },
    "total_return": {
      "type": "number",
      "description": "Total return percentage"
    },
    "total_trades": {
      "type": "number",
      "description": "Total number of trades executed"
    },
    "winning_trades": {
      "type": "number",
      "description": "Number of winning trades"
    },
    "losing_trades": {
      "type": "number",
      "description": "Number of losing trades"
    },
    "win_rate": {
      "type": "number",
      "description": "Win rate percentage"
    },
    "profit_factor": {
      "type": "number",
      "description": "Ratio of gross profit to gross loss"
    },
    "max_drawdown": {
      "type": "number",
      "description": "Maximum drawdown percentage"
    },
    "sharpe_ratio": {
      "type": "number",
      "description": "Risk-adjusted return metric"
    },
    "avg_win": {
      "type": "number",
      "description": "Average winning trade amount"
    },
    "avg_loss": {
      "type": "number",
      "description": "Average losing trade amount"
    },
    "largest_win": {
      "type": "number",
      "description": "Largest winning trade"
    },
    "largest_loss": {
      "type": "number",
      "description": "Largest losing trade"
    },
    "trades_detail": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "asset": {
            "type": "string"
          },
          "action": {
            "type": "string"
          },
          "price": {
            "type": "number"
          },
          "quantity": {
            "type": "number"
          },
          "profit_loss": {
            "type": "number"
          },
          "confidence": {
            "type": "number"
          },
          "sentiment_score": {
            "type": "number"
          }
        }
      },
      "description": "Detailed trade history"
    },
    "equity_curve": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "date": {
            "type": "string"
          },
          "equity": {
            "type": "number"
          },
          "drawdown": {
            "type": "number"
          }
        }
      },
      "description": "Portfolio equity over time"
    },
    "status": {
      "type": "string",
      "enum": [
        "running",
        "completed",
        "failed"
      ],
      "default": "running",
      "description": "Status of backtest"
    },
    "duration_seconds": {
      "type": "number",
      "description": "How long the backtest took to run"
    }
  },
  "required": [
    "name",
    "strategy_config",
    "period",
    "initial_capital"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}