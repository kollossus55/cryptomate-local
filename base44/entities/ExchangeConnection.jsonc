{
  "name": "ExchangeConnection",
  "type": "object",
  "properties": {
    "exchange_name": {
      "type": "string",
      "enum": [
        "okx",
        "coinbase",
        "kraken",
        "bybit"
      ],
      "description": "Name of the exchange"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this connection is active"
    },
    "is_testnet": {
      "type": "boolean",
      "default": true,
      "description": "Whether this is a testnet (demo trading) connection"
    },
    "connection_status": {
      "type": "string",
      "enum": [
        "pending",
        "connected",
        "disconnected",
        "error"
      ],
      "default": "pending",
      "description": "Current connection status"
    },
    "last_sync": {
      "type": "string",
      "description": "Last successful sync timestamp"
    },
    "error_message": {
      "type": "string",
      "description": "Last error message if any"
    },
    "permissions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "API key permissions (read, trade, withdraw)"
    },
    "trading_mode": {
      "type": "string",
      "enum": [
        "simulated",
        "ready_for_live"
      ],
      "default": "simulated",
      "description": "Trading mode: simulated (paper) or ready for live trading"
    },
    "api_key_fingerprint": {
      "type": "string",
      "description": "First/last 4 chars of the API key, for display only. Not sensitive."
    },
    "encrypted_api_key": {
      "type": "string",
      "description": "AES-GCM ciphertext (IV prepended, base64). Written and read ONLY by the exchangeCredentials server function."
    },
    "encrypted_api_secret": {
      "type": "string",
      "description": "AES-GCM ciphertext (IV prepended, base64). Written and read ONLY by the exchangeCredentials server function."
    },
    "encrypted_api_passphrase": {
      "type": "string",
      "description": "AES-GCM ciphertext (IV prepended, base64). OKX requires a passphrase in addition to key/secret. Written and read ONLY by the exchangeCredentials server function."
    }
  },
  "required": [
    "exchange_name"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}