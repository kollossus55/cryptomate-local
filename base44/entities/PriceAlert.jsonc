{
  "name": "PriceAlert",
  "type": "object",
  "properties": {
    "asset_symbol": {
      "type": "string",
      "description": "Trading pair symbol (e.g., BTC/USDT)"
    },
    "alert_type": {
      "type": "string",
      "enum": [
        "price_above",
        "price_below",
        "price_change_percent",
        "volume_spike",
        "volatility",
        "rsi_overbought",
        "rsi_oversold",
        "macd_crossover",
        "macd_crossunder",
        "sma_crossover",
        "sma_crossunder",
        "bollinger_breakout",
        "support_break",
        "resistance_break",
        "ai_pattern"
      ],
      "description": "Type of alert"
    },
    "threshold_value": {
      "type": "number",
      "description": "Threshold value for the alert"
    },
    "current_value": {
      "type": "number",
      "description": "Current value when alert was created"
    },
    "technical_indicator_params": {
      "type": "object",
      "properties": {
        "indicator": {
          "type": "string"
        },
        "period": {
          "type": "number"
        },
        "fast_period": {
          "type": "number"
        },
        "slow_period": {
          "type": "number"
        },
        "signal_period": {
          "type": "number"
        },
        "overbought_level": {
          "type": "number"
        },
        "oversold_level": {
          "type": "number"
        }
      },
      "description": "Parameters for technical indicators"
    },
    "ai_pattern_config": {
      "type": "object",
      "properties": {
        "pattern_type": {
          "type": "string"
        },
        "min_confidence": {
          "type": "number"
        },
        "lookback_period": {
          "type": "string"
        }
      },
      "description": "Configuration for AI pattern detection"
    },
    "is_active": {
      "type": "boolean",
      "default": true,
      "description": "Whether this alert is active"
    },
    "trigger_once": {
      "type": "boolean",
      "default": false,
      "description": "Trigger only once then deactivate"
    },
    "triggered_count": {
      "type": "number",
      "default": 0,
      "description": "Number of times triggered"
    },
    "last_triggered": {
      "type": "string",
      "description": "Last time this alert was triggered"
    },
    "notification_method": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "in_app",
          "email",
          "discord",
          "telegram"
        ]
      },
      "default": [
        "in_app"
      ],
      "description": "How to notify user"
    },
    "discord_webhook": {
      "type": "string",
      "description": "Discord webhook URL for notifications"
    },
    "telegram_config": {
      "type": "object",
      "properties": {
        "bot_token": {
          "type": "string"
        },
        "chat_id": {
          "type": "string"
        }
      },
      "description": "Telegram bot configuration"
    },
    "note": {
      "type": "string",
      "description": "User note for this alert"
    }
  },
  "required": [
    "asset_symbol",
    "alert_type"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}