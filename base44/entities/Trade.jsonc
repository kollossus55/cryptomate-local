{
  "name": "Trade",
  "type": "object",
  "properties": {
    "asset_symbol": {
      "type": "string",
      "description": "Trading pair symbol (e.g., BTC/USDT)"
    },
    "trade_type": {
      "type": "string",
      "enum": [
        "buy",
        "sell"
      ],
      "description": "Type of trade"
    },
    "quantity": {
      "type": "number",
      "description": "Quantity traded"
    },
    "price": {
      "type": "number",
      "description": "Price at execution"
    },
    "total_value": {
      "type": "number",
      "description": "Total value in USDT"
    },
    "exchange": {
      "type": "string",
      "description": "Exchange where trade was executed"
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "completed",
        "failed",
        "cancelled"
      ],
      "default": "pending",
      "description": "Status of the trade"
    },
    "ai_signal": {
      "type": "object",
      "properties": {
        "confidence": {
          "type": "number"
        },
        "reasoning": {
          "type": "string"
        },
        "indicators": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "description": "AI analysis that led to this trade"
    },
    "profit_loss": {
      "type": "number",
      "description": "Profit or loss after closing position"
    },
    "fee": {
      "type": "number",
      "default": 0,
      "description": "Exchange fee paid on this fill."
    },
    "slippage_percent": {
      "type": "number",
      "default": 0,
      "description": "Realised slippage vs intended price."
    },
    "gross_profit_loss": {
      "type": "number",
      "description": "P&L before fees. profit_loss is net."
    },
    "owner_email": {
      "type": "string",
      "description": "Email of the user this trade belongs to. Set by the server worker (which runs as the service role) so RLS can attribute the trade to the owning user."
    }
  },
  "required": [
    "asset_symbol",
    "trade_type",
    "quantity",
    "price",
    "total_value",
    "exchange"
  ],
  "rls": {
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "data.owner_email": "{{user.email}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}