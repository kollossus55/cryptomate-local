{
  "name": "TradingPreferences",
  "type": "object",
  "properties": {
    "trading_style": {
      "type": "string",
      "enum": [
        "conservative",
        "balanced",
        "aggressive",
        "day_trader",
        "swing_trader"
      ],
      "default": "balanced",
      "description": "User's preferred trading style"
    },
    "risk_tolerance": {
      "type": "string",
      "enum": [
        "very_low",
        "low",
        "moderate",
        "high",
        "very_high"
      ],
      "default": "moderate",
      "description": "User's risk tolerance level"
    },
    "signal_alert_thresholds": {
      "type": "object",
      "properties": {
        "min_confidence_buy": {
          "type": "number",
          "default": 70,
          "description": "Minimum confidence % for buy signal alerts"
        },
        "min_confidence_sell": {
          "type": "number",
          "default": 65,
          "description": "Minimum confidence % for sell signal alerts"
        },
        "enable_predictive_alerts": {
          "type": "boolean",
          "default": true,
          "description": "Enable alerts based on predictive price movements"
        },
        "min_predicted_gain": {
          "type": "number",
          "default": 5,
          "description": "Minimum predicted price gain % for buy alerts"
        },
        "news_sentiment_weight": {
          "type": "number",
          "default": 0.3,
          "description": "Weight of news sentiment in signal calculation (0-1)"
        },
        "alert_frequency": {
          "type": "string",
          "enum": [
            "realtime",
            "hourly",
            "daily"
          ],
          "default": "hourly",
          "description": "How often to receive signal alerts"
        }
      },
      "description": "Customizable thresholds for AI signal alerts"
    },
    "preferred_assets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "List of preferred crypto assets (e.g., BTC, ETH)"
    },
    "excluded_assets": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Assets user wants to avoid"
    },
    "watchlist": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "User's watchlist for priority AI analysis"
    },
    "investment_timeframe": {
      "type": "string",
      "enum": [
        "short_term",
        "medium_term",
        "long_term"
      ],
      "default": "medium_term",
      "description": "Preferred investment timeframe"
    },
    "max_position_count": {
      "type": "number",
      "default": 5,
      "description": "Maximum number of simultaneous positions"
    },
    "preferred_profit_target": {
      "type": "number",
      "default": 10,
      "description": "Target profit percentage per trade"
    },
    "max_loss_per_trade": {
      "type": "number",
      "default": 3,
      "description": "Maximum acceptable loss per trade (%)"
    },
    "trading_hours": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean",
          "default": false
        },
        "start_hour": {
          "type": "number"
        },
        "end_hour": {
          "type": "number"
        },
        "timezone": {
          "type": "string"
        }
      },
      "description": "Preferred trading hours"
    },
    "market_cap_preference": {
      "type": "string",
      "enum": [
        "large_cap",
        "mid_cap",
        "small_cap",
        "mixed"
      ],
      "default": "mixed",
      "description": "Preferred market capitalization"
    },
    "volatility_preference": {
      "type": "string",
      "enum": [
        "low",
        "moderate",
        "high"
      ],
      "default": "moderate",
      "description": "Preferred volatility level"
    },
    "diversification_level": {
      "type": "string",
      "enum": [
        "focused",
        "moderate",
        "highly_diversified"
      ],
      "default": "moderate",
      "description": "Desired portfolio diversification"
    },
    "use_technical_analysis": {
      "type": "boolean",
      "default": true,
      "description": "Weight technical indicators in decisions"
    },
    "use_sentiment_analysis": {
      "type": "boolean",
      "default": true,
      "description": "Weight news/social sentiment in decisions"
    },
    "use_fundamental_analysis": {
      "type": "boolean",
      "default": false,
      "description": "Weight fundamental metrics in decisions"
    },
    "rebalancing_frequency": {
      "type": "string",
      "enum": [
        "daily",
        "weekly",
        "monthly",
        "as-needed"
      ],
      "default": "weekly",
      "description": "How often to rebalance portfolio"
    },
    "notification_preferences": {
      "type": "object",
      "properties": {
        "critical_only": {
          "type": "boolean",
          "default": false
        },
        "opportunity_alerts": {
          "type": "boolean",
          "default": true
        },
        "performance_updates": {
          "type": "boolean",
          "default": true
        }
      },
      "description": "Notification preferences"
    },
    "goals": {
      "type": "object",
      "properties": {
        "target_monthly_return": {
          "type": "number"
        },
        "target_annual_return": {
          "type": "number"
        },
        "capital_preservation": {
          "type": "boolean",
          "default": false
        }
      },
      "description": "Trading goals and targets"
    },
    "altcoin_scanner_enabled": {
      "type": "boolean",
      "default": false,
      "description": "Whether the Altcoin Scanner toggle is enabled on the Trading page"
    },
    "paper_base_amount": {
      "type": "number",
      "default": 10000,
      "description": "Starting balance for paper/demo trading reset (e.g. 1000, 3000, 5000, 10000)"
    },
    "notification_retention_days": {
      "type": "number",
      "default": 30,
      "description": "Notifications older than this many days are deleted automatically. 0 keeps them forever."
    }
  },
  "required": [
    "trading_style",
    "risk_tolerance"
  ],
  "rls": {
    "create": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}