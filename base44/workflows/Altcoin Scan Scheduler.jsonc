{
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "altcoin_scan_scheduler",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_scan": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "altcoinScannerWorker",
            "args": {}
          },
          "then": "end",
          "x-base44": {
            "title": "Run altcoin scan",
            "description": "Scans Binance top 100 + caches results"
          }
        }
      }
    ]
  },
  "trigger": {
    "condition": null,
    "config": {
      "trigger_type": "scheduled",
      "events": [],
      "schedule_mode": "recurring",
      "cron_expression": "*/15 * * * *",
      "one_time_date": null,
      "timezone": "UTC",
      "interval_value": null,
      "interval_unit": null,
      "interval_anchor": null,
      "ends_type": "never",
      "ends_on_date": null,
      "ends_after_count": null
    }
  },
  "name": "Altcoin Scan Scheduler",
  "description": "Runs the server-side altcoin scanner every 15 minutes so the Altcoin Scanner page always has fresh cached results without any browser work."
}